{
	"name": "laviac",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "LAVIAC — LeiCraft_MC Auth Virtual Instance Admin Console. A management dashboard for Zitadel virtual instances (System API), built on the full-stack Nuxt + Hono shape.",
	"scripts": {
		"dev": "nuxt dev --port 3000",
		"build": "nuxt build",
		"start": "bun run .output/server/index.mjs --port 3000",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"typecheck": "nuxt typecheck && tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"check": "biome check",
		"format": "biome format --write",
		"lint": "biome lint",
		"api-client:generate": "bun run scripts/api-client-generate.ts",
		"db:generate": "bun scripts/db-utils.ts && bunx --bun drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "bun scripts/db-utils.ts && bunx --bun drizzle-kit migrate --config=drizzle.config.ts"
	},
	"dependencies": {
		"@hey-api/nuxt": "^0.2.1",
		"@nuxt/ui": "^3.0.0",
		"@scalar/hono-api-reference": "^0.9.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"jose": "^6.0.0",
		"nuxt": "^3.16.0",
		"openid-client": "^6.1.0",
		"tailwindcss": "^4.0.0",
		"vue": "^3.5.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@hey-api/openapi-ts": "^0.99.0",
		"@libsql/client": "^0.17.4",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.9.3"
	}
}
