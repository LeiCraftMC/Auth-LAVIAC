{
	"name": "laviac",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "LAVIAC — LeiCraft Auth Virtual Instance Admin Console. A management dashboard for Zitadel virtual instances (System API), built on the full-stack Nuxt + Hono shape.",
	"scripts": {
		"dev": "nuxt dev --port 3000",
		"build": "nuxt build",
		"start": "bun run .output/server/index.mjs --port 3000",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"typecheck": "nuxt typecheck && tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"check": "biome check",
		"format": "biome format --write",
		"lint": "biome lint",
		"api-client:generate": "bun scripts/generate-openapi.ts && openapi-ts",
		"db:generate": "bun scripts/db-utils.ts generate",
		"db:migrate": "bun scripts/db-utils.ts migrate",
		"db:push": "bun scripts/db-utils.ts push"
	},
	"dependencies": {
		"@hey-api/client-fetch": "^0.8.0",
		"@nuxt/ui": "^3.0.0",
		"@scalar/hono-api-reference": "^0.9.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"jose": "^6.0.0",
		"openid-client": "^6.1.0",
		"nuxt": "^3.16.0",
		"tailwindcss": "^4.0.0",
		"vue": "^3.5.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@hey-api/openapi-ts": "^0.64.0",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.0",
		"typescript": "^5.9.3"
	}
}
