
LAVIAC_LOG_LEVEL=info

# Booleans: exactly "true" or "false" (case-sensitive); anything else — including an empty value — fails at startup.
# An unset variable falls back to the schema default.
LAVIAC_API_DISABLE_DOCS=false

LAVIAC_DB_PATH=./data/db.sqlite
LAVIAC_DB_AUTO_MIGRATE=true
LAVIAC_DB_MIGRATION_DIR=./drizzle/migrations

LAVIAC_LOG_DIR=./data/logs
LAVIAC_CONFIG_BASE_DIR=./config

# Public URL of the LAVIAC dashboard itself (used for the OIDC redirect URI).
LAVIAC_APP_URL=http://localhost:12191

# --- Zitadel (self-hosted only) ---
# Base URL of the Zitadel System API. May differ from the auth URL (e.g. a local/internal
# endpoint) — only the backend talks to it; also the system-user JWT audience.
LAVIAC_ZITADEL_SYSTEM_API_URL=https://auth.leicraftmc.de
# The `aud` of the system-user JWT. Zitadel checks it against its own external URL
# (ExternalDomain/ExternalPort/ExternalSecure), not the host it is called on; any other value gets
# 401 Errors.Token.Invalid (AUTH-7fs1e). Defaults to LAVIAC_ZITADEL_SYSTEM_API_URL.
LAVIAC_ZITADEL_SYSTEM_API_AUDIENCE=https://auth.is-on.net
# The system API user id registered in Zitadel runtime settings (SystemAPIUsers).
# Must be lowercase. See https://zitadel.com/docs/guides/integrate/zitadel-apis/access-zitadel-system-api
#
# The instance templates, the default branding and the org/user statistics call the Admin API of each instance with the
# same JWT, which needs IAM_OWNER through a "System" membership (SYSTEM_OWNER alone gets 403):
#   SystemAPIUsers:
#     - laviac-system-user:
#         Path: /path/to/system-user.pub
#         Memberships:
#           - MemberType: System
#             Roles: ["SYSTEM_OWNER", "IAM_OWNER"]
LAVIAC_ZITADEL_SYSTEM_USER_ID=laviac-system-user
# RSA private key (PEM) for the system user — PKCS#8 (`BEGIN PRIVATE KEY`) and PKCS#1
# (`BEGIN RSA PRIVATE KEY`, e.g. from `openssl genrsa -traditional`) are both accepted.
# Either paste the PEM inline or set LAVIAC_ZITADEL_SYSTEM_USER_PRIVATE_KEY_PATH to a file
# path (defaults to ${LAVIAC_CONFIG_BASE_DIR}/system-user.pem). Generate with:
#   openssl genrsa -traditional -out system-user.pem 2048
LAVIAC_ZITADEL_SYSTEM_USER_PRIVATE_KEY_PATH=./config/system-user.pem
# LAVIAC_ZITADEL_SYSTEM_USER_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY----- ...
# Apply the LAVIAC default branding (dark-only, LeiCraft_MC colors, Rubik font, no watermark)
# to every newly created instance.
LAVIAC_ZITADEL_APPLY_DEFAULT_BRANDING=true
# Give every instance of the Zitadel these claims in the ID token, userinfo and JWT access tokens:
# - `urn:lcmc-auth:username`: the plain username (without @<org domain>), when the app requests
#   `profile`. With the org domain suffix on, it is only unique within an org;
# - `urn:lcmc-auth:roles`: the role keys in the app's own project as a list, whenever Zitadel
#   sends the roles;
# - `urn:lcmc-auth:project-roles`: `<project id>:<role key>` for every project whose roles Zitadel
#   sends (the app's own, and others the app requests with `urn:zitadel:iam:org:projects:roles`
#   plus `urn:zitadel:iam:org:project:id:<id>:aud`).
# Namespaced because Zitadel v5 fills a `groups` claim with its own user groups.
# LAVIAC keeps its Actions v2 target `laviac-claims` on `preuserinfo` and `preaccesstoken` of
# every instance (new ones at once, all of them 60 s after startup and every 6 hours; see the
# `syncClaims` task) and replaces the legacy targets `laviac-username-claim` and
# `clean-username-target`. It only attaches the target, and only removes the legacy ones, once a
# signed test call through the webhook URL gets the claims back. `false` removes `laviac-claims`
# from every instance again (the legacy targets stay).
LAVIAC_ZITADEL_CLAIMS=true
# The URL Zitadel calls for it; the instance id is appended. Defaults to
# ${LAVIAC_APP_URL}/api/v1/hooks/claims. Set it when Zitadel reaches LAVIAC under another URL.
# Zitadel refuses targets on localhost and private IPs (ZITADEL_HTTPCLIENT_DENYLIST, keep it), so
# the URL must resolve to a public address: route just /api/v1/hooks/ to LAVIAC if the dashboard
# itself is internal. LAVIAC checks this before it writes anything.
# LAVIAC_ZITADEL_CLAIMS_WEBHOOK_URL=https://laviac.int.leicraftmc.de/api/v1/hooks/claims

# --- Zitadel OIDC (admin login) ---
# Public auth URL — the OIDC issuer users are redirected to for login.
LAVIAC_ZITADEL_AUTH_URL=https://auth.leicraftmc.de
# OIDC client registered in Zitadel for the LAVIAC dashboard (Authorization Code + PKCE).
# Redirect URI must be: ${LAVIAC_APP_URL}/api/v1/auth/callback
LAVIAC_OIDC_CLIENT_ID=laviac
LAVIAC_OIDC_CLIENT_SECRET=
# The Zitadel project role that grants LAVIAC admin access (read from the token/userinfo
# `urn:zitadel:iam:org:project:roles` claim).
LAVIAC_OIDC_ADMIN_ROLE=laviac_admin
# Session lifetime in hours.
LAVIAC_SESSION_TTL_HOURS=12

# --- Static fallback login (required, alongside OIDC) ---
# An env-based admin account that is always available on the login page.
# REQUIRED at boot. The hash must be Bun.password-compatible (argon2id) — generate with:
#   bun run hash-password <password>
LAVIAC_STATIC_AUTH_USERNAME=admin
LAVIAC_STATIC_AUTH_PASSWORD_HASH=$argon2id$...

# --- Host VM ---
# Where the host's root filesystem is visible: "/" when LAVIAC runs directly on the VM, the
# read-only bind mount (e.g. `/:/host:ro` → /host) in Docker. Used for the OS release, hostname,
# disk usage, reboot flag and the apt update check (Debian/Ubuntu hosts).
LAVIAC_HOST_ROOT=/
